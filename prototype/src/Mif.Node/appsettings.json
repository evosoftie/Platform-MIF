{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Mif": {
    "PublicPort": 8080,
    "OperatorPort": 8081,
    "Database": "",
    "Keycloak": {
      "BaseUrl": "http://localhost:8080",
      "Realm": "mif",
      "ClientId": "mif-node",
      "ClientSecret": ""
    },
    "Upstream": {
      "Alias": "entra",
      "DiscoveryUrl": ""
    },
    "Continuity": {
      "ProbeIntervalSeconds": 15,
      "FailureThreshold": 4,
      "RecoveryThreshold": 8
    },
    "Snapshot": {
      "Issuer": "mif-node",
      "TtlHours": 72,
      "KeyDirectory": "keys"
    }
  }
}
